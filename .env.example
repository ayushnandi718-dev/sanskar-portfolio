# Server
PORT=8787

# Where enquiries are sent
CONTACT_TO=pyc0453@gmail.com

# Sender shown on outgoing mail.
# Resend: use a verified address/domain, or the test sender
#         "Sanskar Portfolio <onboarding@resend.dev>"
# SMTP:   usually the same address as SMTP_USER
CONTACT_FROM=

# ---------------------------------------------------------------------------
# Email delivery — choose ONE provider.
# ---------------------------------------------------------------------------

# Option A: Resend (recommended on Vercel — simple HTTPS API, no SMTP ports)
RESEND_API_KEY=

# Option B: SMTP via Nodemailer (Gmail app password, Zoho, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# If neither provider is configured, the form still validates and then shows
# a direct-email fallback instead of silently failing.
